---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import { formatRange } from "../../lib/date";

export const getStaticPaths = (async () => {
  const weeks = await getCollection("weeks");
  const sorted = weeks.sort((a, b) => a.data.weekNumber - b.data.weekNumber);
  return sorted.map((w, i) => ({
    params: { id: w.id },
    props: { week: w, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
  }));
}) satisfies GetStaticPaths;

const { week, prev, next } = Astro.props;
const w = week.data;
const base = import.meta.env.BASE_URL;
---

<Base title={`สัปดาห์ที่ ${w.weekNumber} · ${w.title}`} description={w.assignment}>
  <article class="page narrow">
    <p class="crumb"><a href={`${base}weeks`}>← กลับไปหน้าสารบัญ</a></p>

    <header class="head">
      <span class="bignum" aria-hidden="true">{String(w.weekNumber).padStart(2, "0")}</span>
      <p class="label">สัปดาห์ที่ {w.weekNumber} · {formatRange(w.dateStart, w.dateEnd)}</p>
      <h1>{w.title}</h1>
    </header>

    <hr class="rule" />

    <section class="blk">
      <h2 class="hd">งานที่ได้รับมอบหมาย</h2>
      <p class="txt">{w.assignment}</p>
    </section>

    <section class="blk">
      <h2 class="hd">ขั้นตอนการทำงาน</h2>
      <ol class="steps">{w.steps.map((s) => <li>{s}</li>)}</ol>
    </section>

    <section class="blk">
      <h2 class="hd">ภาพจากหน้างาน</h2>
      <PhotoGrid photos={w.photos} />
    </section>

    <section class="learn sheet taped tape-left">
      <h2 class="hd small">สิ่งที่ได้เรียนรู้</h2>
      <p class="hand">{w.learned}</p>
    </section>

    <div class="pair">
      <section class="blk pb">
        <h2 class="hd small"><span class="mk red">ปัญหาที่พบ</span></h2>
        <p class="txt">{w.problem}</p>
      </section>
      <section class="blk pb">
        <h2 class="hd small"><span class="mk green">วิธีแก้ไข</span></h2>
        <p class="txt">{w.solution}</p>
      </section>
    </div>

    <nav class="pager" aria-label="สัปดาห์ก่อนหน้าและถัดไป">
      {prev ? (
        <a class="pg" href={`${base}weeks/${prev.id}`}>
          <span class="dir">← สัปดาห์ที่ {prev.data.weekNumber}</span>
          <strong>{prev.data.title}</strong>
        </a>
      ) : <span />}
      {next ? (
        <a class="pg right" href={`${base}weeks/${next.id}`}>
          <span class="dir">สัปดาห์ที่ {next.data.weekNumber} →</span>
          <strong>{next.data.title}</strong>
        </a>
      ) : <span />}
    </nav>
  </article>
</Base>

<style>
  .narrow { max-width: 820px; padding-bottom: 3rem; }
  .crumb { padding-top: 1.6rem; font-size: .9rem; }
  .crumb a { font-family: var(--font-hand); color: var(--ink-red); text-decoration: none; }

  .head { position: relative; padding-block: 1.4rem .4rem; }
  .bignum {
    position: absolute;
    right: -.5rem;
    top: .2rem;
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 8.5rem);
    font-weight: 700;
    line-height: .82;
    color: var(--ink-red);
    opacity: .1;
    pointer-events: none;
  }
  .head h1 { font-size: clamp(1.7rem, 5vw, 2.5rem); margin-top: .35rem; max-width: 20ch; }

  .blk { margin-bottom: 2.1rem; }
  .hd {
    font-size: 1.16rem;
    margin-bottom: .65rem;
    position: relative;
    padding-bottom: .3rem;
  }
  .hd::after {
    content: "";
    position: absolute; left: 0; bottom: 0;
    width: 2.4rem; height: 2.5px;
    background: var(--ink-red); opacity: .7; rotate: -.7deg;
  }
  .hd.small { font-size: 1.02rem; }
  .hd.small::after { display: none; }

  /* ไฮไลต์ปากกาเมจิก — ระบายบนตัวอักษรโดยตรง */
  .mk {
    display: inline-block;
    padding-inline: .3rem;
    rotate: -.6deg;
    background-repeat: no-repeat;
    background-size: 100% 88%;
    background-position: 0 78%;
  }
  .mk.red {
    background-image: linear-gradient(
      100deg,
      color-mix(in srgb, var(--ink-red) 30%, transparent) 0%,
      color-mix(in srgb, var(--ink-red) 22%, transparent) 88%,
      transparent 100%
    );
  }
  .mk.green {
    background-image: linear-gradient(
      95deg,
      color-mix(in srgb, var(--ink-green) 38%, transparent) 0%,
      color-mix(in srgb, var(--ink-green) 26%, transparent) 90%,
      transparent 100%
    );
  }

  .txt { color: var(--ink-2); }

  .steps { list-style: none; counter-reset: st; margin: 0; padding: 0; }
  .steps li {
    counter-increment: st;
    position: relative;
    padding-left: 2.2rem;
    margin-bottom: .7rem;
    color: var(--ink-2);
  }
  .steps li::before {
    content: counter(st);
    position: absolute; left: 0; top: .1em;
    width: 1.55rem; height: 1.55rem;
    display: grid; place-items: center;
    font-family: var(--font-display); font-size: .82rem; font-weight: 600;
    color: var(--ink-red);
    border: 1.5px solid var(--ink-red);
    border-radius: 50%;
    opacity: .85;
  }

  .learn {
    padding: 1.5rem 1.55rem 1.6rem;
    rotate: -.7deg;
    margin: 2.6rem 0 2.4rem;
    background: color-mix(in srgb, var(--ink-blue) 7%, var(--paper-2));
  }
  .learn .hand { font-size: 1.03rem; color: var(--ink-2); }

  .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1.6rem; }
  .pb { margin-bottom: 1rem; }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.4rem;
    padding-top: 1.6rem;
    border-top: 1px dashed var(--rule);
  }
  .pg {
    display: flex; flex-direction: column; gap: .1rem;
    text-decoration: none; color: inherit;
    transition: translate .18s ease;
  }
  .pg:hover { translate: -3px 0; }
  .pg.right:hover { translate: 3px 0; }
  .dir { font-family: var(--font-hand); font-size: .85rem; color: var(--ink-red); }
  .pg strong { font-family: var(--font-display); font-size: .95rem; font-weight: 500; color: var(--ink-2); }
  .pg.right { text-align: right; }

  @media (max-width: 620px) {
    .pager { grid-template-columns: 1fr; gap: 1.2rem; }
    .pg.right { text-align: left; }
  }
</style>
