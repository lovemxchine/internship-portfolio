---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import WeekCard from "../../components/WeekCard.astro";
import { formatRange } from "../../lib/date";

const weeks = (await getCollection("weeks")).sort((a, b) => a.data.weekNumber - b.data.weekNumber);
const base = import.meta.env.BASE_URL;
---

<Base
  title="ผลงานรายสัปดาห์"
  description={`บันทึกผลงานการฝึกงานทั้งหมด ${weeks.length} สัปดาห์`}
>
  <div class="page">
    <SectionHead
      eyebrow="ผลงานรายสัปดาห์"
      title={`บันทึกทั้งหมด ${weeks.length} สัปดาห์`}
      lede="แต่ละสัปดาห์บันทึกงานที่ได้รับมอบหมาย ขั้นตอนการทำงาน สิ่งที่ได้เรียนรู้ ปัญหาที่พบและวิธีแก้ไข พร้อมภาพประกอบ กดที่การ์ดเพื่อดูรายละเอียด"
    />
    <div class="cards">
      {
        weeks.map((w) => (
          <WeekCard
            href={`${base}weeks/${w.id}`}
            weekNumber={w.data.weekNumber}
            title={w.data.title}
            dateLabel={formatRange(w.data.dateStart, w.data.dateEnd)}
            assignment={w.data.assignment}
            photoCount={w.data.photos.length}
            cover={w.data.photos[0].src}
            coverAlt={w.data.photos[0].caption}
          />
        ))
      }
    </div>
  </div>
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 1.1rem;
    padding-bottom: 1rem;
  }
</style>
