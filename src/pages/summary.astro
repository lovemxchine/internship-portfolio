---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";

const entry = await getEntry("summary", "summary");
if (!entry) throw new Error("ไม่พบ summary.json");
const s = entry.data;
---

<Base title="สรุปผลการฝึกงาน" description={s.gained}>
  <div class="page narrow">
    <SectionHead eyebrow="หน้าสุดท้ายของสมุด" title="สรุปผลการฝึกงาน" />

    <section class="blk">
      <h2 class="hd">สิ่งที่ได้รับจากการฝึกงาน</h2>
      <p class="txt">{s.gained}</p>
    </section>

    <section class="blk">
      <h2 class="hd">ทักษะที่พัฒนา</h2>
      <ul class="ticks">{s.skillsDeveloped.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section class="blk">
      <h2 class="hd">ความประทับใจ</h2>
      <blockquote class="quote">{s.impression}</blockquote>
    </section>

    <section class="note sheet taped washi-heart">
      <h2 class="hd small">ข้อเสนอแนะ</h2>
      <p class="hand">{s.suggestion}</p>
    </section>
  </div>
</Base>

<style>
  .narrow { max-width: 720px; padding-bottom: 3rem; }

  .blk { margin-bottom: 2.2rem; }
  .hd {
    font-size: 1.2rem;
    margin-bottom: .7rem;
    position: relative;
    padding-bottom: .3rem;
  }
  .hd::after {
    content: "";
    position: absolute; left: 0; bottom: 0;
    width: 2.4rem; height: 2.5px;
    background: var(--ink-red); opacity: .7; rotate: -.7deg;
  }
  .hd.small { font-size: 1.02rem; }
  .txt { color: var(--ink-2); }

  .ticks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .6rem; }
  .ticks li { position: relative; padding-left: 1.6rem; color: var(--ink-2); }
  .ticks li::before {
    content: "✓";
    position: absolute; left: 0; top: -.05em;
    font-family: var(--font-hand); color: var(--ink-green); font-size: 1.05rem;
  }

  .quote {
    margin: 0;
    padding-left: 1.3rem;
    border-left: 3px solid var(--ink-red);
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--ink);
  }

  .note {
    padding: 1.5rem 1.5rem 1.6rem;
    rotate: -.8deg;
    margin-top: 3rem;
    background: color-mix(in srgb, var(--ink-green) 8%, var(--paper-2));
  }
  .note .hand { font-size: 1.02rem; color: var(--ink-2); }
</style>
