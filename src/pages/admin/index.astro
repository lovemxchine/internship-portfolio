---
import "../../styles/tokens.css";
import { COLLECTIONS } from "./schema";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="ipf-base" content={base} />
    <title>จัดการข้อมูล · สมุดบันทึกฝึกงาน</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mali:wght@400;500;600&family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <script id="cfg" type="application/json" set:html={JSON.stringify(COLLECTIONS)} is:inline />

    <header class="bar">
      <div class="page bar-in">
        <strong>จัดการข้อมูลเว็บไซต์</strong>
        <div class="bar-right">
          <span id="who" class="who"></span>
          <button id="logout" class="ghost" hidden>ออกจากระบบ</button>
        </div>
      </div>
    </header>

    <main class="page wrap">
      <section id="login" class="sheet pad">
        <h1>เข้าสู่ระบบ</h1>
        <p class="muted">ใส่ชื่อผู้ใช้และรหัสผ่านที่ได้รับตอนส่งมอบเว็บไซต์</p>
        <form id="loginform">
          <label class="fld">
            <span>ชื่อผู้ใช้</span>
            <input id="user" type="text" autocomplete="username" required />
          </label>
          <label class="fld">
            <span>รหัสผ่าน</span>
            <input id="pass" type="password" autocomplete="current-password" required />
          </label>
          <p class="row">
            <button id="signin" class="stamp" type="submit">เข้าสู่ระบบ</button>
          </p>
        </form>
        <p id="loginerr" class="err" hidden></p>
      </section>

      <section id="app" hidden>
        <nav class="tabs" id="tabs"></nav>
        <div id="panel"></div>
      </section>
    </main>

    <div id="toast" class="toast" hidden></div>

    <script>
      import { mountAdmin } from "./admin-client";
      mountAdmin();
    </script>

    <style is:global>
      body { background: var(--paper); }
      [hidden] { display: none !important; }
      .bar { border-bottom: 1px solid var(--rule); background: var(--paper-2); position: sticky; top: 0; z-index: 5; }
      .bar-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: .8rem; }
      .bar strong { font-family: var(--font-display); }
      .bar-right { display: flex; align-items: center; gap: .8rem; }
      .who { font-size: .85rem; color: var(--ink-3); }
      .wrap { padding-block: 1.6rem 4rem; max-width: 900px; }
      .pad { padding: 1.4rem 1.5rem; }
      h1 { font-size: 1.4rem; margin-bottom: .6rem; }
      .muted { color: var(--ink-2); }
      .small { font-size: .85rem; }
      .err { color: #b3261e; margin-top: var(--gap); }
      code { background: var(--paper); padding: .1rem .35rem; border-radius: 4px; font-size: .85em; }

      /* ระยะห่างมีค่าเดียวทั้งหน้า แนวตั้งกับแนวนอนเท่ากัน */
      .wrap { --gap: 1.1rem; }
      .cardbody, .sub, #loginform { display: grid; gap: var(--gap); }
      .cardbody, .sub-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      #loginform { margin-top: var(--gap); }
      #loginform .row { margin-top: 0; }
      .fld { display: block; margin: 0; grid-column: 1 / -1; }
      .fld.half { grid-column: span 1; }
      .fld > span { display: block; font-size: .85rem; color: var(--ink-2); margin-bottom: .35rem; }
      input, textarea, select {
        width: 100%; font: inherit; font-size: .95rem; color: var(--ink);
        background: var(--paper-2); border: 1.5px solid var(--rule);
        border-radius: var(--radius-sm); padding: .5rem .7rem;
      }
      textarea { min-height: 5.5rem; resize: vertical; line-height: 1.7; }
      input:focus, textarea:focus, select:focus { outline: 2px solid var(--ink-red); outline-offset: 1px; border-color: transparent; }

      .row { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; margin-top: var(--gap); }
      button { font: inherit; cursor: pointer; }
      .ghost {
        background: none; border: 1.5px solid var(--rule); color: var(--ink-2);
        border-radius: 99px; padding: .3rem .9rem; font-size: .85rem;
      }
      .ghost:hover { color: var(--ink); border-color: var(--ink-3); }
      .danger { color: #b3261e; border-color: #e7bdb9; }

      .tabs { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: var(--gap); }
      .tab {
        background: var(--paper-2); border: 1.5px solid var(--rule); color: var(--ink-2);
        border-radius: 99px; padding: .35rem 1rem; font-size: .92rem;
      }
      .tab.on { background: var(--ink-red); border-color: var(--ink-red); color: #fff; font-weight: 600; }

      .card { background: var(--paper-2); border: 1px solid var(--paper-edge); border-radius: var(--radius); padding: var(--gap) 1.2rem; margin-bottom: .7rem; box-shadow: var(--shadow-photo); }
      .card > summary {
        display: flex; align-items: center; justify-content: space-between; gap: .8rem;
        cursor: pointer; list-style: none; user-select: none;
      }
      .card > summary::-webkit-details-marker { display: none; }
      .card > summary h3 { font-size: 1rem; font-weight: 500; }
      .card > summary h3::before {
        content: "▸"; display: inline-block; width: 1.1em;
        color: var(--ink-3); transition: rotate .18s ease;
      }
      .card[open] > summary h3::before { rotate: 90deg; }
      .card[open] > summary { border-bottom: 1px dashed var(--rule); padding-bottom: var(--gap); margin-bottom: var(--gap); }
      details.card:not([open]) { padding-block: .5rem; margin-bottom: .45rem; }
      .sub { border: 1px dashed var(--rule); border-radius: var(--radius-sm); padding: var(--gap); margin: 0; }
      .line.imgrow { grid-column: 1 / -1; }
      .sub .row { margin-top: 0; grid-column: 1 / -1; }
      .stack { display: grid; gap: var(--gap); grid-column: 1 / -1; }
      .sub > span { grid-column: 1 / -1; font-size: .85rem; color: var(--ink-2); }

      /* ปุ่มเลือกไฟล์ — input จริงซ่อนอยู่ใน label เพราะข้อความในปุ่มของเบราว์เซอร์เปลี่ยนเป็นไทยไม่ได้ */
      .pickbtn {
        display: inline-flex; align-items: center; gap: .45rem;
        font-family: var(--font-display); font-weight: 600; font-size: .9rem;
        color: var(--ink-red); cursor: pointer; user-select: none;
        padding: .42rem 1.1rem; border-radius: 99px;
        background: color-mix(in srgb, var(--ink-red) 12%, transparent);
        border: 1.5px dashed color-mix(in srgb, var(--ink-red) 40%, transparent);
        transition: background .16s ease, translate .16s ease;
      }
      .pickbtn::before { content: "\2191"; font-size: 1.05em; line-height: 1; }
      .pickbtn:hover { background: color-mix(in srgb, var(--ink-red) 20%, transparent); translate: 0 -1px; }
      .pickbtn:active { translate: 0 1px; }
      .pickbtn:focus-within { outline: 2px solid var(--ink-red); outline-offset: 3px; }
      .pickbtn:has(input:disabled) { opacity: .45; cursor: not-allowed; translate: none; }

      .thumb { width: 84px; height: 84px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--paper-edge); background: var(--paper); }
      .imgrow { display: flex; align-items: center; gap: .8rem; }

      .toast {
        position: fixed; left: 50%; bottom: 1.4rem; translate: -50% 0; z-index: 20;
        background: var(--ink); color: var(--paper-2); padding: .6rem 1.2rem;
        border-radius: 99px; font-size: .9rem; box-shadow: var(--shadow-lift);
      }
      .toast.bad { background: #b3261e; }
      .sticky-save { position: sticky; bottom: 0; margin-top: var(--gap); background: var(--paper); padding: .9rem 0; border-top: 1px solid var(--rule); }
      .hint { display: block; margin-top: .4rem; font-size: .82rem; color: var(--ink-3); word-break: break-all; }
      .tools { margin-top: 0; gap: .35rem; }
      .tools .ghost { padding: .25rem .6rem; min-width: 2rem; }
      .ghost:disabled { opacity: .35; cursor: not-allowed; }
      .stamp:disabled { opacity: .45; cursor: not-allowed; box-shadow: none; }
      .sticky-save .hint { margin: 0; }
      #panel > .stamp { margin-top: var(--gap); }

      @media (max-width: 720px) {
        .cardbody, .sub-grid { grid-template-columns: 1fr; }
      }

      @media (max-width: 560px) {
        .bar-in { flex-wrap: wrap; gap: .5rem; padding-block: .6rem; }
        .who { width: 100%; order: 3; }
        .wrap { --gap: .85rem; }
        .pad { padding: 1.1rem 1rem; }
        .card { padding: var(--gap); }
        /* 16px กันไม่ให้ iOS ซูมเข้าตอนแตะช่องกรอก */
        input, textarea, select { font-size: 16px; padding: .55rem .65rem; }
        .imgrow { align-items: flex-start; }
        .thumb { width: 64px; height: 64px; }
        input[type="file"] { font-size: .85rem; }
        .sticky-save .stamp { width: 100%; text-align: center; }
      }
    </style>
  </body>
</html>
