---
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import WeekCard from "../components/WeekCard.astro";
import { formatRange } from "../lib/date";

const profile = await getEntry("profile", "profile");
if (!profile) throw new Error("ไม่พบ profile.json");
const p = profile.data;

const weeks = (await getCollection("weeks")).sort((a, b) => a.data.weekNumber - b.data.weekNumber);
const latest = weeks.slice(-2).reverse();
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Base title="หน้าแรก" description={p.intro}>
  <section class="page cover">
    <div class="cover-grid">
      <div class="left">
        <p class="label">บันทึกผลงานการฝึกงาน</p>
        <h1>{p.fullName}</h1>

        <p class="posting">
          <span>{p.department}</span>
          <span class="at">ที่</span>
          <span class="co">{p.company}</span>
        </p>

        <p class="intro">{p.intro}</p>

        <p class="cta">
          <a class="stamp" href={`${base}weeks`}>เปิดบันทึกรายสัปดาห์</a>
          <a class="stamp outline" href={`${base}profile`}>ประวัติส่วนตัว</a>
        </p>
      </div>

      <figure class="portrait polaroid taped tape-right washi-grid">
        <Image src={p.avatar} alt={`รูปของ ${p.fullName}`} widths={[300, 600]} sizes="(max-width: 880px) 55vw, 290px" />
        <figcaption>{p.fullName.split(" ")[0]} · {p.studentId}</figcaption>
      </figure>

      <aside class="slip sheet taped tape-left washi-star">
        <dl>
          <div><dt>รหัสนักศึกษา</dt><dd>{p.studentId}</dd></div>
          <div><dt>ระยะเวลาฝึกงาน</dt><dd>{p.periodLabel}</dd></div>
          <div><dt>บันทึกแล้ว</dt><dd>{weeks.length} สัปดาห์</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="page latest">
    <hr class="rule" />
    <div class="latest-head">
      <h2>บันทึกล่าสุด</h2>
      <a class="all" href={`${base}weeks`}>ดูครบทุกสัปดาห์ →</a>
    </div>
    <div class="cards">
      {
        latest.map((w, i) => (
          <WeekCard
            href={`${base}weeks/${w.id}`}
            weekNumber={w.data.weekNumber}
            title={w.data.title}
            dateLabel={formatRange(w.data.dateStart, w.data.dateEnd)}
            assignment={w.data.assignment}
            photoCount={w.data.photos.length}
            cover={w.data.photos[0].src}
            coverAlt={w.data.photos[0].caption}
            index={i}
          />
        ))
      }
    </div>
  </section>
</Base>

<style>
  .cover { padding-block: clamp(1.8rem, 6vw, 3.6rem) 1rem; }
  .cover-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr);
    grid-template-areas:
      "text photo"
      "text slip";
    grid-template-rows: auto 1fr;
    column-gap: clamp(1.6rem, 5vw, 3.4rem);
    row-gap: 1.6rem;
    align-items: start;
  }
  .left { grid-area: text; }
  .portrait { grid-area: photo; }
  .slip { grid-area: slip; }

  h1 {
    font-size: clamp(2.1rem, 7.2vw, 3.7rem);
    font-weight: 700;
    margin-block: .3rem .55rem;
    line-height: 1.2;
  }

  .posting {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.4vw, 1.16rem);
    color: var(--ink-2);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1.1rem;
    display: inline-block;
  }
  .at { color: var(--ink-3); padding-inline: .3rem; font-style: italic; }
  .co { color: var(--ink-red); font-weight: 600; }

  .intro { color: var(--ink-2); max-width: 42ch; }

  .cta { display: flex; gap: 1rem; flex-wrap: wrap; padding-top: 1.6rem; }

  .portrait { rotate: 1.7deg; margin: 0 0 0 auto; max-width: 290px; width: 100%; }
  .portrait img { aspect-ratio: 1; object-fit: cover; }

  .slip { padding: 1rem 1.15rem; rotate: -1deg; }
  .slip dl { margin: 0; display: flex; flex-direction: column; gap: .7rem; }
  .slip div { display: flex; flex-direction: column; }
  .slip dt {
    font-size: .7rem;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .slip dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: .98rem;
    line-height: 1.4;
  }

  .latest { padding-block: 1.2rem 2rem; }
  .latest-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.3rem;
  }
  .latest-head h2 { font-size: 1.5rem; }
  .all { font-family: var(--font-display); font-size: .93rem; font-weight: 600; color: var(--ink-red); text-decoration: none; }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: 2rem 1.6rem;
  }

  /* มือถือ: รูปก่อน แล้วชื่อ แล้วค่อยกล่องข้อมูล */
  @media (max-width: 880px) {
    .cover-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "photo"
        "text"
        "slip";
      grid-template-rows: auto;
      row-gap: 1.5rem;
    }
    .portrait { margin: 0; max-width: 200px; rotate: -1.6deg; }
    .slip { rotate: .8deg; }
    .cta { padding-top: 1.2rem; }
  }
</style>
