---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";

const items = await getCollection("gallery");
const categories = ["ทั้งหมด", "การทำงาน", "การประชุม", "กิจกรรมบริษัท", "ผลงานที่ภาคภูมิใจ"];
const washi = ["washi-grid","washi-berry","washi-heart","washi-dot","washi-star"];
const tilts = [-0.9, 0.6, -0.4, 0.8, -0.7, 0.5, -0.5, 0.7];
---

<Base title="แกลเลอรี" description="รวมภาพและวิดีโอกิจกรรมระหว่างการฝึกงาน">
  <div class="page">
    <SectionHead
      eyebrow="ภาพติดสมุด"
      title="แกลเลอรี"
      lede="บรรยากาศการทำงาน การประชุม กิจกรรมบริษัท และผลงานที่ภาคภูมิใจ กดที่ภาพเพื่อดูขนาดเต็ม"
    />

    <div class="filters" role="group" aria-label="กรองตามหมวด">
      {
        categories.map((c, i) => (
          <button
            type="button"
            class:list={["fbtn", { on: i === 0 }]}
            data-cat={c}
            style={`--tilt:${(i % 2 ? 1 : -1) * (0.3 + (i % 3) * 0.15)}deg`}
          >
            {c}
          </button>
        ))
      }
    </div>

    <div class="wall">
      {
        items.map((item, i) => {
          const d = item.data;
          const tilt = `--tilt:${tilts[i % tilts.length]}deg`;
          const tapeCls = `${i % 3 === 0 ? "tape-left" : i % 3 === 1 ? "" : "tape-right"} ${washi[i % washi.length]}`;

          if (d.kind === "photo") {
            return (
              <figure class:list={["tile", "reveal", "polaroid", "taped", tapeCls]} style={tilt} data-cat={d.category}>
                <button type="button" class="open" data-full={d.src.src} data-cap={d.caption}>
                  <Image src={d.src} alt={d.caption} widths={[380, 760]} sizes="(max-width: 720px) 92vw, 380px" />
                  <span class="sr-only">ดูภาพขนาดเต็ม: {d.caption}</span>
                </button>
                <figcaption>{d.caption}</figcaption>
              </figure>
            );
          }

          if (d.kind === "video-upload") {
            return (
              <figure class:list={["tile", "reveal", "polaroid", "taped", "wide", tapeCls]} style={tilt} data-cat={d.category}>
                <video controls preload="none" poster={d.poster?.src} playsinline>
                  <source src={d.file} />
                  เบราว์เซอร์ของคุณไม่รองรับการเล่นวิดีโอ
                </video>
                <figcaption>{d.caption}</figcaption>
              </figure>
            );
          }

          return (
            <figure class:list={["tile", "reveal", "polaroid", "taped", "wide", tapeCls]} style={tilt} data-cat={d.category}>
              <div class="ratio">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${d.youtubeId}`}
                  title={d.caption}
                  loading="lazy"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              </div>
              <figcaption>{d.caption}</figcaption>
            </figure>
          );
        })
      }
    </div>

    <p class="empty hand" hidden>ยังไม่มีภาพในหมวดนี้</p>

    <dialog id="lb">
      <form method="dialog"><button class="x" aria-label="ปิด">✕</button></form>
      <div class="lb-frame">
        <img id="lb-img" alt="" />
        <p id="lb-cap" class="hand"></p>
      </div>
    </dialog>
  </div>
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>("#lb");
  const img = document.querySelector<HTMLImageElement>("#lb-img");
  const cap = document.querySelector<HTMLParagraphElement>("#lb-cap");

  document.querySelectorAll<HTMLButtonElement>(".open").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!dlg || !img || !cap) return;
      img.src = btn.dataset.full ?? "";
      img.alt = btn.dataset.cap ?? "";
      cap.textContent = btn.dataset.cap ?? "";
      dlg.showModal();
    });
  });

  dlg?.addEventListener("click", (e) => {
    if (e.target === dlg) dlg.close();
  });

  const tiles = document.querySelectorAll<HTMLElement>(".tile");
  const empty = document.querySelector<HTMLElement>(".empty");
  document.querySelectorAll<HTMLButtonElement>(".fbtn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".fbtn").forEach((b) => b.classList.remove("on"));
      btn.classList.add("on");
      const cat = btn.dataset.cat;
      let shown = 0;
      tiles.forEach((t) => {
        const hide = cat !== "ทั้งหมด" && t.dataset.cat !== cat;
        t.hidden = hide;
        if (!hide) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: .6rem; padding-bottom: 1.6rem; }
  .fbtn {
    font-family: var(--font-display);
    font-size: .89rem;
    font-weight: 500;
    padding: .32rem .85rem;
    border: 1.5px solid var(--rule);
    border-radius: 99px;
    background: var(--paper-2);
    color: var(--ink-2);
    cursor: pointer;
    rotate: var(--tilt, 0deg);
    box-shadow: var(--shadow-photo);
    transition: color .16s ease, border-color .16s ease, translate .12s ease;
  }
  .fbtn:hover { color: var(--ink); border-color: var(--ink-2); translate: -1px -1px; }
  .fbtn.on {
    background: var(--ink-red);
    border-color: var(--ink-red);
    color: var(--paper-2);
    box-shadow: 0 6px 14px -6px var(--ink-red);
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 2.2rem 1.4rem;
    padding-bottom: 2.5rem;
    align-items: start;
  }
  .tile { rotate: var(--tilt); margin: 0; }
  .tile[hidden] { display: none; }
  .tile.wide { grid-column: span 2; }
  @media (max-width: 560px) { .tile.wide { grid-column: span 1; } }

  .open { display: block; padding: 0; border: 0; background: none; cursor: zoom-in; width: 100%; }
  .open :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  video { width: 100%; aspect-ratio: 16 / 9; background: #171310; display: block; }
  .ratio { position: relative; aspect-ratio: 16 / 9; background: #171310; }
  .ratio iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .empty { padding: 1rem 0 3rem; color: var(--ink-3); }

  dialog {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(93vw, 960px);
    max-height: 93vh;
    overflow: visible;
  }
  dialog::backdrop { background: rgba(36, 27, 18, .8); }
  .lb-frame {
    background: var(--paper-2);
    padding: 12px 12px 0;
    border: 1px solid var(--paper-edge);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
  }
  .lb-frame img { border-radius: var(--radius-sm); width: 100%; max-height: 76vh; object-fit: contain; background: var(--paper-edge); }
  .lb-frame p { padding: .75rem .3rem 1rem; font-size: .93rem; text-align: center; color: var(--ink-2); }
  .x {
    position: absolute; right: -12px; top: -14px; z-index: 2;
    width: 38px; height: 38px;
    border: 1.5px solid var(--paper-edge);
    cursor: pointer;
    background: var(--paper-2); color: var(--ink);
    box-shadow: var(--shadow-photo);
    font-size: .95rem;
    border-radius: 50%;
  }
</style>
