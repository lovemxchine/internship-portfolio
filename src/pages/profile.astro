---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";

const profile = await getEntry("profile", "profile");
if (!profile) throw new Error("ไม่พบ profile.json");
const p = profile.data;
---

<Base title="ประวัติส่วนตัว" description={`ประวัติการศึกษา ทักษะ และช่องทางติดต่อของ ${p.fullName}`}>
  <div class="page">
    <SectionHead eyebrow="ทำความรู้จัก" title="ประวัติและทักษะ" lede={p.intro} />

    <div class="layout">
      <section class="edu">
        <h2 class="hd">ประวัติการศึกษา</h2>
        <ol class="tl">
          {p.education.map((e) => (
            <li>
              <span class="yr">{e.year}</span>
              <span class="dt">{e.detail}</span>
            </li>
          ))}
        </ol>

        <h2 class="hd sp">ความสามารถพิเศษ</h2>
        <ul class="ticks">
          {p.talents.map((t) => <li>{t}</li>)}
        </ul>
      </section>

      <aside class="side">
        <section class="sheet card">
          <h2 class="hd">ทักษะ</h2>
          <ul class="skills">
            {p.skills.map((s) => (
              <li><span class="nm">{s.name}</span><span class="lv hand">{s.level}</span></li>
            ))}
          </ul>
        </section>

        <section class="sheet card contact">
          <h2 class="hd">ติดต่อ</h2>
          <ul class="contacts">
            {p.contacts.map((c) => (
              <li>
                <span class="lbl">{c.label}</span>
                {c.href ? <a href={c.href}>{c.value}</a> : <span>{c.value}</span>}
              </li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    gap: clamp(1.6rem, 4.5vw, 3rem);
    align-items: start;
    padding-bottom: 2.5rem;
  }

  .hd {
    font-size: 1.22rem;
    margin-bottom: .9rem;
    position: relative;
    padding-bottom: .3rem;
  }
  .hd::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0;
    width: 2.6rem; height: 2.5px;
    background: var(--ink-red);
    opacity: .7;
    rotate: -.7deg;
  }
  .sp { margin-top: 2.4rem; }

  .tl { list-style: none; margin: 0; padding: 0; }
  .tl li {
    position: relative;
    padding-left: 1.5rem;
    padding-bottom: 1.4rem;
    border-left: 1.5px dashed var(--rule);
  }
  .tl li:last-child { border-left-color: transparent; padding-bottom: 0; }
  .tl li::before {
    content: "";
    position: absolute;
    left: -6px; top: .62em;
    width: 10px; height: 10px;
    background: var(--paper);
    border: 2px solid var(--ink-red);
    border-radius: 50%;
  }
  .yr { display: block; font-family: var(--font-hand); font-size: .87rem; color: var(--ink-red); }
  .dt { display: block; font-size: 1rem; }

  .ticks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .55rem; }
  .ticks li { position: relative; padding-left: 1.5rem; color: var(--ink-2); }
  .ticks li::before {
    content: "✓";
    position: absolute; left: 0; top: -.05em;
    font-family: var(--font-hand);
    color: var(--ink-green);
    font-size: 1.05rem;
  }

  .side { display: flex; flex-direction: column; gap: 1.5rem; }
  .card { padding: 1.2rem 1.35rem 1.4rem; rotate: -.7deg; }
  .contact { rotate: .8deg; }

  .skills { list-style: none; margin: 0; padding: 0; }
  .skills li {
    display: flex; align-items: baseline; justify-content: space-between; gap: .8rem;
    padding: .5rem 0;
    border-bottom: 1px dotted var(--rule);
  }
  .skills li:last-child { border-bottom: 0; padding-bottom: 0; }
  .nm { font-family: var(--font-display); font-weight: 500; }
  .lv { font-size: .85rem; color: var(--ink-green); white-space: nowrap; }

  .contacts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .6rem; }
  .contacts li { display: flex; gap: .7rem; align-items: baseline; flex-wrap: wrap; }
  .lbl {
    font-size: .69rem; letter-spacing: .13em; text-transform: uppercase;
    color: var(--ink-3); min-width: 4.6rem;
  }
  .contacts a { color: var(--ink-blue); text-underline-offset: 3px; }

  @media (max-width: 840px) {
    .layout { grid-template-columns: 1fr; }
    .card, .contact { rotate: 0deg; }
  }
</style>
