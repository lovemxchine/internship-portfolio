---
import "../styles/tokens.css";
import { ClientRouter } from "astro:transitions";
import { getEntry } from "astro:content";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const profile = await getEntry("profile", "profile");
const name = profile?.data.fullName ?? "";
const company = profile?.data.company ?? "";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const here = Astro.url.pathname.replace(/\/$/, "");

const nav = [
  { href: base, label: "หน้าแรก" },
  { href: `${base}profile`, label: "ประวัติ" },
  { href: `${base}weeks`, label: "รายสัปดาห์" },
  { href: `${base}gallery`, label: "แกลเลอรี" },
  { href: `${base}summary`, label: "สรุปผล" },
];

const isActive = (href: string) => {
  const clean = href.replace(/\/$/, "");
  return clean === base.replace(/\/$/, "") ? here === clean : here.startsWith(clean);
};
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {name}</title>
    {description && <meta name="description" content={description} />}
    <ClientRouter />
    <meta name="theme-color" content="#f2fbfa" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Mali:wght@400;500;600&family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <a href="#main" class="skip">ข้ามไปยังเนื้อหาหลัก</a>

    <header class="site-head">
      <div class="page head-inner">
        <a href={base} class="brand">
          <img class="cologo" src={`${base}company-logo.webp`} alt="" width="128" height="128" />
          <span class="brand-text">
            <em class="eyebrow">สมุดบันทึกฝึกงานที่</em>
            <strong>{company}</strong>
            <em class="hand">{name}</em>
          </span>
        </a>

        <input type="checkbox" id="navtoggle" class="sr-only" />
        <label for="navtoggle" class="burger">
          <span></span><span></span><span></span>
          <span class="sr-only">เปิดหรือปิดเมนู</span>
        </label>

        <nav class="nav" aria-label="เมนูหลัก">
          {
            nav.map((item, i) => (
              <a
                href={item.href}
                class:list={["nav-link", { on: isActive(item.href) }]}
                style={`--tilt:${(i % 2 ? 1 : -1) * (0.25 + (i % 3) * 0.12)}deg`}
              >
                {isActive(item.href) && <span class="pill" aria-hidden="true" />}
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="page">
        <hr class="rule" />
        <p class="hand">{name} · บันทึกไว้ระหว่างการฝึกงาน</p>
        <p class="stamped">
          ปรับปรุงล่าสุด {new Date().toLocaleDateString("th-TH", { dateStyle: "long" })}
        </p>
        <p><a href={`${base}admin/`} class="admin-link">จัดการข้อมูล</a></p>
      </div>
    </footer>

    <style
      is:global
      define:vars={{
        wGrid: `url(${base}decor/tape-grid.png)`,
        wBerry: `url(${base}decor/tape-berry.png)`,
        wHeart: `url(${base}decor/tape-heart.png)`,
        wDot: `url(${base}decor/tape-dot.png)`,
        wStar: `url(${base}decor/tape-kraft.png)`,
      }}
    >
      .washi-grid  { --washi: var(--wGrid); }
      .washi-berry { --washi: var(--wBerry); }
      .washi-heart { --washi: var(--wHeart); }
      .washi-dot   { --washi: var(--wDot); }
      .washi-star  { --washi: var(--wStar); }

      .skip {
        position: absolute;
        left: -9999px;
        background: var(--ink-red);
        color: var(--paper-2);
        padding: .6rem 1rem;
        z-index: 100;
      }
      .skip:focus { left: 0; top: 0; }

      .site-head {
        position: relative;
        z-index: 20;
        border-bottom: 1px solid var(--rule);
        background: color-mix(in srgb, var(--paper) 92%, transparent);
      }
      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding-block: .95rem;
      }

      .brand { display: inline-flex; align-items: center; gap: .8rem; text-decoration: none; }

      .cologo { width: 128px; height: 128px; object-fit: contain; flex: none; border-radius: 8px; }
      .eyebrow { font-size: .72rem; font-style: normal; color: var(--ink-3); letter-spacing: .02em; }

      /* คลิปหนีบกระดาษ */
      .clip {
        width: 17px;
        height: 34px;
        flex: none;
        border: 2.5px solid var(--ink-2);
        border-radius: 9px;
        rotate: -14deg;
        position: relative;
        opacity: .78;
      }
      .clip::before {
        content: "";
        position: absolute;
        inset: 5px 4px 9px;
        border: 2px solid var(--ink-2);
        border-radius: 5px 5px 0 0;
        border-bottom: 0;
      }

      .brand-text { display: flex; flex-direction: column; line-height: 1.25; }
      .brand-text strong { font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; }
      .brand-text em { font-size: .8rem; font-style: normal; color: var(--ink-3); }

      .nav { display: flex; gap: .35rem; flex-wrap: wrap; }
      .nav-link {
        position: relative;
        font-family: var(--font-display);
        font-size: .95rem;
        font-weight: 500;
        text-decoration: none;
        padding: .3rem .55rem;
        color: var(--ink-2);
        rotate: var(--tilt, 0deg);
        transition: color .18s ease;
      }
      .nav-link:hover { color: var(--ink); }
      .nav-link.on { color: var(--ink-red); font-weight: 600; isolation: isolate; }

      /* พื้นหลังเม็ดยาเป็น element แยก ตัวหนังสือไม่ขยับตาม */
      .pill {
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: 99px;
        background: color-mix(in srgb, var(--ink-red) 13%, transparent);
      }
      @media (prefers-reduced-motion: no-preference) {
        .pill { view-transition-name: navpill; }
      }

      .burger { display: none; }

      @media (max-width: 780px) {
        .burger {
          display: flex;
          flex-direction: column;
          justify-content: center;
          gap: 5px;
          width: 44px;
          height: 44px;
          padding: 0 10px;
          border: 1.5px solid var(--rule);
          background: var(--paper-2);
          cursor: pointer;
          rotate: -1deg;
        }
        .burger > span:not(.sr-only) {
          display: block;
          height: 2px;
          background: var(--ink-2);
          transition: transform .22s ease, opacity .22s ease;
        }
        .nav {
          display: none;
          width: 100%;
          flex-direction: column;
          gap: .1rem;
          padding: .4rem 0 .6rem;
          border-top: 1px dashed var(--rule);
          margin-top: .2rem;
        }
        #navtoggle:checked ~ .nav { display: flex; }
        #navtoggle:checked ~ .burger > span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        #navtoggle:checked ~ .burger > span:nth-child(2) { opacity: 0; }
        #navtoggle:checked ~ .burger > span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
        #navtoggle:focus-visible ~ .burger { outline: 2px solid var(--ink-red); outline-offset: 3px; }
        .nav-link { padding: .55rem .6rem; font-size: 1.02rem; rotate: 0deg; }
      }

      main { display: block; padding-bottom: 3rem; }

      .site-foot { padding-bottom: 2.5rem; text-align: center; }
      .site-foot p { color: var(--ink-3); }
      .admin-link {
        display: inline-block;
        margin-top: .7rem;
        font-size: .8rem;
        color: var(--ink-3);
        text-decoration: none;
        border-bottom: 1px dashed var(--rule);
      }
      .admin-link:hover { color: var(--ink-red); border-color: var(--ink-red); }

      .stamped {
        font-size: .78rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--ink-3);
        opacity: .75;
        margin-top: .35rem;
      }
    </style>
  </body>
</html>
