---
import { Image } from "astro:assets";
interface Props {
  href: string;
  weekNumber: number;
  title: string;
  dateLabel: string;
  assignment: string;
  photoCount: number;
  cover: ImageMetadata;
  coverAlt: string;
  index?: number;
}
const { href, weekNumber, title, dateLabel, assignment, photoCount, cover, coverAlt, index = 0 } = Astro.props;
// เอียงไม่เท่ากันทีละใบ ไม่ให้ดูเป็นกริดโรงงาน
const tilts = [-1.4, 0.9, -0.5, 1.5, -1.1, 0.6];
const tilt = tilts[index % tilts.length];
---
<a class="wc" href={href} style={`--tilt:${tilt}deg`}>
  <span class="num" aria-hidden="true">{String(weekNumber).padStart(2, "0")}</span>
  <figure class="polaroid taped">
    <Image src={cover} alt={coverAlt} widths={[340, 680]} sizes="(max-width: 720px) 92vw, 330px" />
    <figcaption>{photoCount} ภาพในสัปดาห์นี้</figcaption>
  </figure>
  <div class="body">
    <p class="date">{dateLabel}</p>
    <h2>{title}</h2>
    <p class="excerpt">{assignment}</p>
    <p class="more">อ่านบันทึกสัปดาห์นี้ →</p>
  </div>
</a>

<style>
  .wc {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: .9rem;
    text-decoration: none;
    color: inherit;
    rotate: var(--tilt);
    transition: rotate .3s cubic-bezier(.2,.8,.3,1);
    padding-top: .6rem;
  }
  .wc:hover { rotate: 0deg; }
  .wc:hover .polaroid { transform: scale(1.015); box-shadow: var(--shadow-lift); }

  .num {
    position: absolute;
    top: -.7rem;
    right: -.15rem;
    z-index: 4;
    font-family: var(--font-display);
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--ink-red);
    opacity: .17;
    pointer-events: none;
  }

  .polaroid img { aspect-ratio: 4 / 3; object-fit: cover; }

  .body { display: flex; flex-direction: column; gap: .28rem; padding-inline: .2rem; }
  .date { font-family: var(--font-hand); font-size: .88rem; color: var(--ink-red); }
  .body h2 { font-size: 1.18rem; }
  .excerpt {
    color: var(--ink-2); font-size: .93rem;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .more {
    font-family: var(--font-display); font-weight: 600;
    font-size: .9rem; color: var(--ink-red); padding-top: .2rem;
  }
</style>
