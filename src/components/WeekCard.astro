---
import { Image } from "astro:assets";
interface Props {
  href: string;
  weekNumber: number;
  title: string;
  dateLabel: string;
  assignment: string;
  photoCount: number;
  cover: ImageMetadata;
  coverAlt: string;
}
const { href, weekNumber, title, dateLabel, assignment, photoCount, cover, coverAlt } = Astro.props;
---
<a class="wc card" href={href}>
  <div class="thumb">
    <Image src={cover} alt={coverAlt} widths={[320, 640]} sizes="(max-width: 700px) 100vw, 340px" />
    <span class="badge">สัปดาห์ที่ {weekNumber}</span>
  </div>
  <div class="body">
    <p class="date">{dateLabel}</p>
    <h2>{title}</h2>
    <p class="excerpt">{assignment}</p>
    <p class="more"><span class="chip">{photoCount} ภาพ</span><span class="go">อ่านต่อ →</span></p>
  </div>
</a>

<style>
  .wc {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .wc:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .thumb { position: relative; aspect-ratio: 3 / 2; background: var(--surface-2); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .badge {
    position: absolute; left: .7rem; top: .7rem;
    font-family: var(--font-display); font-size: .78rem; font-weight: 600;
    background: var(--accent); color: var(--accent-ink);
    padding: .2rem .7rem; border-radius: var(--r-pill);
  }
  .body { padding: 1rem 1.1rem 1.15rem; display: flex; flex-direction: column; gap: .35rem; flex: 1; }
  .date { font-size: .82rem; color: var(--ink-soft); }
  .body h2 { font-size: 1.06rem; }
  .excerpt {
    color: var(--ink-soft); font-size: .92rem;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .more {
    margin-top: auto; padding-top: .6rem;
    display: flex; align-items: center; justify-content: space-between; gap: .5rem;
  }
  .go { font-family: var(--font-display); font-size: .88rem; font-weight: 600; color: var(--accent); }
</style>
