---
interface Props { eyebrow?: string; title: string; lede?: string; }
const { eyebrow, title, lede } = Astro.props;
---
<header class="sh">
  {eyebrow && <p class="label">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <hr class="rule" />
</header>

<style>
  .sh { padding-block: clamp(2rem, 5.5vw, 3.4rem) 0; max-width: 46rem; }
  .sh h1 { font-size: clamp(1.85rem, 5.2vw, 2.85rem); margin-block: .35rem .7rem; }
  .lede { color: var(--ink-2); max-width: var(--maxw-text); }
  .rule { margin-bottom: 1.6rem; }
</style>
