---
interface Props { eyebrow?: string; title: string; lede?: string; }
const { eyebrow, title, lede } = Astro.props;
---
<header class="sh">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .sh { padding-block: clamp(1.8rem, 5vw, 3rem) 1.4rem; }
  .sh h1 { font-size: clamp(1.6rem, 4.4vw, 2.3rem); margin-block: .3rem .5rem; }
</style>
