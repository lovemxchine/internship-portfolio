---
import { Image } from "astro:assets";
interface Props { photos: { src: ImageMetadata; caption: string }[]; }
const { photos } = Astro.props;
---
<div class="grid">
  {photos.map((p) => (
    <figure class="card">
      <Image src={p.src} alt={p.caption} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" />
      {p.caption && <figcaption>{p.caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }
  figure { margin: 0; overflow: hidden; }
  figure :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  figcaption { padding: .65rem .85rem .8rem; font-size: .88rem; color: var(--ink-soft); }
</style>
