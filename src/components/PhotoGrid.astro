---
import { Image } from "astro:assets";
interface Props { photos: { src: ImageMetadata; caption: string }[]; }
const { photos } = Astro.props;
const tilts = [-0.9, 0.6, -0.4, 0.8, -0.7, 0.5];
---
<div class="wall">
  {photos.map((p, i) => (
    <figure
      class:list={["polaroid", "taped", i % 3 === 0 ? "tape-left" : i % 3 === 1 ? "" : "tape-right"]}
      style={`--tilt:${tilts[i % tilts.length]}deg`}
    >
      <Image src={p.src} alt={p.caption} widths={[420, 840]} sizes="(max-width: 720px) 88vw, 300px" />
      {p.caption && <figcaption>{p.caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 232px), 1fr));
    gap: 1.9rem 1.3rem;
    padding-block: .8rem .4rem;
  }
  .polaroid { rotate: var(--tilt); margin: 0; }
  .polaroid img { aspect-ratio: 4 / 3; object-fit: cover; }
</style>
